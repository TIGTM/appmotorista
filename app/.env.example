# Credenciais do piloto local. Nunca coloque senhas reais no frontend.
APP_DRIVER_USER=silas
APP_DRIVER_PASSWORD=defina-uma-senha-local
PORT=4180

# Primeiro acesso da área administrativa.
APP_ADMIN_USER=logistica
APP_ADMIN_PASSWORD=defina-uma-senha-forte-local
APP_ADMIN_NOME=Logistica GTM

# Consulta no servidor (somente leitura).
SANKHYA_API_PROXY_URL=http://127.0.0.1:13000/sql
SANKHYA_API_PROXY_TOKEN=defina-o-token-no-ambiente-do-servidor

# Baixa oficial: mantenha false durante homologacao e habilite somente depois
# de validar o proxy/credencial de servico.
SANKHYA_BAIXA_ATIVA=false
SANKHYA_ACTION_PROXY_URL=http://127.0.0.1:13000/service
# No BancoDeDadosSankhya, este token deve ser igual ao API_TOKEN do proxy.
SANKHYA_ACTION_PROXY_TOKEN=defina-o-token-do-servico-no-ambiente-do-servidor

# Alternativa para execucao no mesmo servidor do sankhya-mcp:
# SANKHYA_MCP_DIR=C:\\caminho\\sankhya-mcp
# SANKHYA_CLIENT_ID=...
# SANKHYA_CLIENT_SECRET=...
# SANKHYA_APPKEY=...
