# Credenciais do piloto. Nunca versionar o arquivo .env real.
APP_DRIVER_USER=silas
APP_DRIVER_PASSWORD=defina-uma-senha-forte-no-servidor
APP_DRIVER_CODPARC=41850
APP_DRIVER_NOME=SILAS HENRIQUE DE OLIVEIRA
APP_DRIVER_CODEMP=2
APP_DRIVER_EMPRESA=Industria - GTM Beneficiadora
PORT=4180

# No servidor, use o proxy Sankhya interno; nao copie o sankhya-mcp para este app.
SANKHYA_API_PROXY_URL=http://127.0.0.1:13000/sql
SANKHYA_API_PROXY_TOKEN=defina-o-token-no-ambiente-do-servidor

# Acao oficial da tela Ordens de Carga. A baixa fica bloqueada por padrao.
SANKHYA_BAIXA_ATIVA=false
SANKHYA_ACTION_PROXY_URL=http://127.0.0.1:13000/service
SANKHYA_ACTION_PROXY_TOKEN=defina-o-token-do-servico-no-ambiente-do-servidor

# Use no lugar do proxy de servico apenas se o app puder acessar o OAuth no
# servidor. Nunca coloque estas credenciais no frontend.
# SANKHYA_CLIENT_ID=...
# SANKHYA_CLIENT_SECRET=...
# SANKHYA_APPKEY=...
